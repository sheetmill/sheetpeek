   "steps": [
    {
     "op": "open"
    },
    {
     "op": "view",
     "sheet": "Sheet",
     "select": "Sheet!AZ300",
     "zoom": 100,
     "scroll_row": 1,
     "scroll_column": 1
    },
    {
     "op": "read",
     "id": "geometry",
     "range": "Sheet!A1:O13",
     "props": [
      "left",
      "top",
      "width",
      "height",
      "text"
     ]
    },
    {
     "op": "read_format",
     "id": "display",
     "range": "Sheet!A1:O13",
     "props": [
      "interior.color",
      "interior.pattern"
     ],
     "display": true
    },
    {
     "op": "view",
     "sheet": "Sheet",
     "select": "Sheet!AZ300",
     "id": "view_z100",
     "zoom": 100,
     "scroll_row": 1,
     "scroll_column": 1
    },
    {
     "op": "capture_window",
     "id": "shot_z100",
     "name": "text_steps_shrink_fonts_z100.png"
    },
    {
     "op": "close",
     "save": false
    }
   ]
  }
 ]
