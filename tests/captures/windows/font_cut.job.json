{
 "schema": 1,
 "job_id": "sheetpeek-20261123-182134-font-cut",
 "package": "sheetpeek",
 "purpose": "sheetpeek capture group font_cut: window pictures of cells whose fonts lie past the workbook's font table's cut, under other themes and Normal fonts, at zoom 100 (suite font_cut)",
 "limits": {
  "job_seconds": 1800,
  "step_seconds": 600
 },
